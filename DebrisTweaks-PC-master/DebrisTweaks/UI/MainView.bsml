<bg id="container" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
	<bg background="title-gradient" size-delta="90 8" anchor-min="0.5 1" anchor-max="0.5 1" background-color="#FFF3" background-color0="#FFF0" background-color1="#FFFF" pivot="0.5 1">
		<text text="Tweaks" anchor-min="0 0" anchor-max="1 1" size-delta="0 0" font-size="6" italics="true" all-uppercase="false" align="Midline" />
	</bg>

	<tab-selector tab-tag="tabs" size-delta="0 7" anchored-position="0 -10" />

	<tab tags="tabs" tab-name="Main" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-20" anchored-position-x="4">
			<toggle-setting apply-on-change='true' value='ModToggle' id='ModToggleID' text='Enable Debris Tweaks' hover-hint='Default Value: True'/>
			<slider-setting apply-on-change='true' value='VelocityMult' id='VelocityMultID' text='Velocity Multiplier' formatter="multiplier-formatter" show-buttons='true' min='-10' max='10' increment='0.1' hover-hint='Default Value: 1'/>
			<slider-setting apply-on-change='true' value='Drag' id='DragID' text='Drag' show-buttons='true' min='0' max='15' increment='0.1' hover-hint='Default Value: 0'/>

		</settings-container>
	</tab>

	<tab tags="tabs" tab-name="Physics" size-delta-y="-16" anchored-position-y="-8">
			<settings-container size-delta-x="-20" anchored-position-x="4">
				<toggle-setting apply-on-change='true' value='FixDebris' id='FixDebrisID' text='Fix Debris Physics' hover-hint='Reverts previous debris physics logic before 1.38 by using force instead of linear velocity. Makes debris less snappy.'/>
				<toggle-setting apply-on-change='true' value='GravityToggle' id='GravityToggleID' text='Enable Gravity' hover-hint='Default Value: True'/>
				<toggle-setting apply-on-change='true' value='RotationToggle' id='RotationToggleID' text='Prevent Rotations' hover-hint='Default Value: False'/>
			</settings-container>
	</tab>
	<tab tags="tabs" tab-name="Drag" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-20" anchored-position-x="4">
			<toggle-setting apply-on-change='true' value='RandomDrag' id='RandomDragID' text='Random Drag' hover-hint='Randomize drag'/>
			<slider-setting apply-on-change='true' value='DragMin' id='DragMinID' text='Drag Min' show-buttons='true' min='0' max='15' increment='0.1' hover-hint='Default Value: 1'/>
			<slider-setting apply-on-change='true' value='DragMax' id='DragMaxID' text='Drag Max' show-buttons='true' min='0' max='15' increment='0.1' hover-hint='Default Value: 1'/>
		</settings-container>
	</tab>
	<tab tags="tabs" tab-name="Positioning" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-20" anchored-position-x="4">
			<slider-setting apply-on-change='true' value='offsetX' id='offsetXID' text='Offset X' formatter="length-formatter" show-buttons='true' min='-15' max='15' increment='0.1' hover-hint='Offset debris to left or right'/>
			<slider-setting apply-on-change='true' value='offsetY' id='offsetYID' text='Offset Y' formatter="length-formatter" show-buttons='true' min='-15' max='15' increment='0.1' hover-hint='Offset debris up or down'/>
			<slider-setting apply-on-change='true' value='offsetZ' id='offsetZID' text='Offset Z' formatter="length-formatter" show-buttons='true' min='-15' max='15' increment='0.1' hover-hint='Offset debris futher or closer to the player'/>
		</settings-container>
	</tab>
	<vertical pref-height='8' pref-width='100' anchor-pos-y='-20' horizontal-fit='PreferredSize'>
		<horizontal>
			<increment-setting pref-width='50' value='profile_value' apply-on-change='true' bind-value='true' text='Profile' integer-only='true' min='1' max='5' hover-hint='Select what profile you want to save to or load to '/>
			<button align='Center' on-click='saveclicked' text='Save' hover-hint='Save profile'></button>
			<button align='Center' on-click='loadclicked' text='Load' hover-hint='Load profile for this screen'></button>
			<button align='Center' on-click='loadallclicked' text='Load All' hover-hint='Load profile for all screens'></button>
		</horizontal>
	</vertical>
	<vertical pref-height='8' pref-width='100' anchor-pos-y='-30' horizontal-fit='PreferredSize'>
		<button align='Center' on-click='test-debris' text='Test Debris' hover-hint='See how the debris looks'></button>
	</vertical>
</bg>