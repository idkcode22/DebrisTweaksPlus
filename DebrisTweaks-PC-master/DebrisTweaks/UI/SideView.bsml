<bg id="container" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
	<bg background="title-gradient" size-delta="90 8" anchor-min="0.5 1" anchor-max="0.5 1" background-color="#FFF3" pivot="0.5 1">
		<text text="Cosmetic" anchor-min="0 0" anchor-max="1 1" size-delta="0 0" font-size="6" italics="true" all-uppercase="false" align="Midline" />
	</bg>

	<tab-selector tab-tag="tabs" size-delta="0 7" anchored-position="0 -10" />

	<tab tags="tabs" tab-name="Lifespan" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-10" anchored-position-x="4">
			<horizontal pref-height='8' pref-width='100' anchor-pos-y='35' horizontal-fit='PreferredSize'>
				<slider-setting apply-on-change="true" value="minLifetime" id="minLifetimeID" text="Min Lifespan Time" formatter="time-formatter" show-buttons="true" min="0" max="15" increment="0.1" hover-hint='Note: Lifespan is based on the time until the next note. The minimum of time that the debris appears for.'/>
				<button text='Reset' font-size="4" align="Center" on-click="resetMinLifeTime"/>
			</horizontal>
			<horizontal pref-height='8' pref-width='100' anchor-pos-y='35' horizontal-fit='PreferredSize'>
				<slider-setting apply-on-change="true" value="maxLifetime" id="maxLifetimeID" text="Max Lifespan Time" formatter="time-formatter" show-buttons="true" min="0.1" max="15" increment="0.1" hover-hint='Note: Lifespan is based on the time until the next note. The maximum of time that the debris appears for.'/>
				<button text='Reset' font-size="4" align="Center" on-click="resetMaxLifeTime"/>
			</horizontal>
			<horizontal pref-height='8' pref-width='100' anchor-pos-y='35' horizontal-fit='PreferredSize'>
				<slider-setting apply-on-change="true" value="lifeTimeOffset" id="lifeTimeOffsetID" text="Lifespan Offset Time" formatter="time-formatter" show-buttons="true" min="-1" max="15" increment="0.05" hover-hint='Note: Lifespan is based on the time until the next note. The offset in which the debris lasts for until next note.'/>
				<button text='Reset' font-size="4" align="Center" on-click="resetLifeTimeOffset"/>
			</horizontal>
		</settings-container>
	</tab>
	<tab tags="tabs" tab-name="Dissolve" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-10" anchored-position-x="4">
			<toggle-setting apply-on-change='true' value='disableDissolveAnim' id='disableDissolveAnimID' text='Disable the dissolve animation.' hover-hint='Default Value: False'/>
			<toggle-setting apply-on-change='true' value='downscaleDespawnAnim' id='downscaleDespawnAnimID' text='Downscale debris instead of dissolving.' hover-hint='Default Value: False'/>
			<toggle-setting apply-on-change='true' value='overrideDissolveNoiseScale' id='overrideDissolveNoiseScaleID' text='Override debris dissolve noise' hover-hint='Default Value: False'/>
			<slider-setting apply-on-change="true" value="dissolveNoise" id="dissolveNoiseID" text="Dissolve Noise" show-buttons="true" min="0.1" max="100" increment="0.1" hover-hint='How much noise there is when dissolving.'/>
		</settings-container>
	</tab>
	<tab tags="tabs" tab-name="Color override/Scale" size-delta-y="-16" anchored-position-y="-8">
		<settings-container size-delta-x="-10" anchored-position-x="4">
			<toggle-setting apply-on-change='true' value='CustomColourToggle' id='CustomColourToggleID' text='Enable Custom Debris Colours' hover-hint='Default Value: False'/>
			<color-setting apply-on-change='true' value='LeftColour' id='LeftColourID' text='Left Debris Colour' hover-hint='Default Value: 255, 0, 0'/>
			<color-setting apply-on-change='true' value='RightColour' id='RightColourID' text='Right Debris Colour'  hover-hint='Default Value: 0, 0, 255'/>
			<slider-setting apply-on-change="true" value="DebrisScale" id="DebrisScaleID" text="Scale" formatter="multiplier-formatter" show-buttons="true"  min="0.1" max="2" increment="0.05"  hover-hint='Default Value: 1'/>
		</settings-container>
	</tab>
	<vertical pref-height='8' pref-width='100' anchor-pos-y='-30' horizontal-fit='PreferredSize'>
		<button align='Center' on-click='loadclicked' text='Load' hover-hint='Load profile for this screen'></button>
	</vertical>
</bg>